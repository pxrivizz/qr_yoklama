generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum SessionStatus {
  ACTIVE
  CLOSED
  VOIDED
}

enum CourseMemberRole {
  OWNER
  INSTRUCTOR
  ASSISTANT
}

enum VerificationMode {
  REQUIRED
  DISABLED
}

enum SessionCreationSource {
  SYSTEM_QR
  TEACHER_MANUAL
}

enum CourseAttendanceMode {
  STANDARD
  PREPARATORY
}

enum AttendanceSlotType {
  WEEKLY
  CALENDAR_PERIOD
}

enum AttendanceSource {
  QR_SCAN
  TEACHER_MANUAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  FLAGGED
}

enum AttemptStatus {
  ACCEPTED
  REJECTED
  FLAGGED
}

enum QrScanActionType {
  YOKLAMA
  GIRIS
  CIKIS
}

enum QrScanResult {
  SUCCESS
  FLAGGED
  INVALID_QR
  EXPIRED_QR
  DUPLICATE_SCAN
  DEVICE_ALREADY_USED
  OUT_OF_RADIUS
  OUT_OF_NETWORK
  NOT_ENROLLED
  PHOTO_REQUIRED
  ERROR
}

enum BugReportStatus {
  PENDING
  IN_PROGRESS
  FIXED
}

model User {
  id                  String               @id @default(cuid())
  roles               UserRole[]           @default([STUDENT])
  name                String?
  normalizedName      String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  googleId            String?              @unique
  schoolNumber        String?
  passwordHash        String?
  passwordChangedAt   DateTime?
  authVersion         Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  sessions            Session[]
  authenticators      Authenticator[]
  taughtCourses       Course[]             @relation("CourseTeacher")
  matchedEnrollments  Enrollment[]         @relation("MatchedStudent")
  createdSessions     AttendanceSession[]  @relation("SessionCreator")
  voidedSessions      AttendanceSession[]  @relation("SessionVoider")
  attendanceRecords   AttendanceRecord[]   @relation("RecordStudent")
  manuallyEntered     AttendanceRecord[]   @relation("RecordEnteredBy")
  attendanceRevisions AttendanceRevision[] @relation("RevisionEditor")
  courseMemberships   CourseMember[]
  attendanceAttempts  AttendanceAttempt[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  qrScanLogs          QrScanLog[]          @relation("UserScanLogs")
  notifications       Notification[]
  bugReports          BugReport[]          @relation("BugReporter")
  handledBugReports   BugReport[]          @relation("BugReportHandler")
  bugReportResponses  BugReportResponse[]  @relation("BugReportResponseAuthor")

  @@index([roles], type: Gin)
  @@index([normalizedName])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refreshToken") @db.Text
  access_token      String? @map("accessToken") @db.Text
  expires_at        Int?    @map("expiresAt")
  token_type        String? @map("tokenType")
  scope             String?
  id_token          String? @map("idToken") @db.Text
  session_state     String? @map("sessionState")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("AuthSession")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Course {
  id                  String                     @id @default(cuid())
  teacherId           String
  name                String
  code                String
  schoolLat           Float
  schoolLng           Float
  allowedRadiusMeters Int                        @default(100)
  allowedIpRanges     String[]
  weeklySessionCount  Int
  totalWeeks          Int
  attendanceMode      CourseAttendanceMode       @default(STANDARD)
  mandatoryAlertLimit Int?
  archivedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  teacher             User                       @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  members             CourseMember[]
  attendancePolicy    CourseAttendancePolicy?
  enrollments         Enrollment[]
  attendanceSessions  AttendanceSession[]
  preparatoryDayPlans CoursePreparatoryDayPlan[]
  qrScanLogs          QrScanLog[]
  notifications       Notification[]

  @@unique([teacherId, code])
  @@index([teacherId])
  @@index([archivedAt])
}

model CourseMember {
  courseId  String
  userId    String
  role      CourseMemberRole
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@index([userId, role])
}

model CourseAttendancePolicy {
  courseId                  String           @id
  photoMode                 VerificationMode @default(REQUIRED)
  networkMode               VerificationMode @default(REQUIRED)
  locationMode              VerificationMode @default(REQUIRED)
  deviceMode                VerificationMode @default(REQUIRED)
  maxLocationAccuracyMeters Int?
  lateAfterMinutes          Int?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  course                    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CoursePreparatoryDayPlan {
  courseId    String
  weekday     Int
  lessonCount Int
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, weekday])
}

model Enrollment {
  id                   String                  @id @default(cuid())
  courseId             String
  fullNameOnList       String
  normalizedNameOnList String
  schoolNumberOnList   String
  isMandatory          Boolean                 @default(false)
  matchedUserId        String?
  matchedAt            DateTime?
  archivedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  course               Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  matchedUser          User?                   @relation("MatchedStudent", fields: [matchedUserId], references: [id], onDelete: SetNull)
  attendanceRecords    AttendanceRecord[]
  deviceClaims         AttendanceDeviceClaim[]
  attendanceAttempts   AttendanceAttempt[]
  qrScanLogs           QrScanLog[]

  @@unique([courseId, schoolNumberOnList])
  @@index([courseId, normalizedNameOnList])
  @@index([matchedUserId])
  @@index([courseId, archivedAt])
}

model AttendanceSession {
  id                  String                  @id @default(cuid())
  courseId            String
  slotType            AttendanceSlotType      @default(WEEKLY)
  weekNumber          Int?
  sessionIndexInWeek  Int?
  sessionDate         DateTime?               @db.Date
  lessonPeriod        Int?
  startedAt           DateTime                @default(now())
  endedAt             DateTime?
  status              SessionStatus           @default(ACTIVE)
  createdBy           SessionCreationSource
  createdByUserId     String
  schoolLat           Float
  schoolLng           Float
  allowedRadiusMeters Int
  allowedIpRanges     String[]
  policySnapshot      Json                    @default("{}")
  voidedAt            DateTime?
  voidedByUserId      String?
  voidReason          String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  course              Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdByUser       User                    @relation("SessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedByUser        User?                   @relation("SessionVoider", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  qrTokens            QrToken[]
  attendanceRecords   AttendanceRecord[]
  deviceClaims        AttendanceDeviceClaim[]
  attendanceAttempts  AttendanceAttempt[]
  qrScanLogs          QrScanLog[]
  notifications       Notification[]

  @@index([courseId, status])
  @@index([courseId, sessionDate])
}

model QrToken {
  id        String            @id @default(cuid())
  sessionId String
  issuedAt  DateTime
  expiresAt DateTime
  nonceHash String            @unique
  signature String            @unique
  createdAt DateTime          @default(now())
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
}

model AttendanceRecord {
  id                    String               @id @default(cuid())
  sessionId             String
  enrollmentId          String
  studentId             String?
  source                AttendanceSource
  recordedAt            DateTime             @default(now())
  ipAddress             String?
  latitude              Float?
  longitude             Float?
  accuracyMeters        Float?
  distanceMeters        Float?
  deviceFingerprintHash String?
  status                AttendanceStatus
  excuseReason          String?
  note                  String?
  enteredByTeacherId    String?
  editedAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  session               AttendanceSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment            Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student               User?                @relation("RecordStudent", fields: [studentId], references: [id], onDelete: SetNull)
  enteredByTeacher      User?                @relation("RecordEnteredBy", fields: [enteredByTeacherId], references: [id], onDelete: SetNull)
  revisions             AttendanceRevision[]

  @@unique([sessionId, enrollmentId])
  @@index([sessionId, deviceFingerprintHash])
  @@index([studentId, recordedAt])
  @@index([sessionId, status])
}

model AttendanceRevision {
  id             String           @id @default(cuid())
  recordId       String
  editedByUserId String
  beforeStatus   AttendanceStatus
  afterStatus    AttendanceStatus
  beforeNote     String?
  afterNote      String?
  reason         String           @db.Text
  createdAt      DateTime         @default(now())
  record         AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  editedByUser   User             @relation("RevisionEditor", fields: [editedByUserId], references: [id], onDelete: Restrict)

  @@index([recordId, createdAt])
  @@index([editedByUserId, createdAt])
}

model AttendanceDeviceClaim {
  sessionId             String
  deviceFingerprintHash String
  enrollmentId          String
  createdAt             DateTime          @default(now())
  session               AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment            Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@id([sessionId, deviceFingerprintHash])
  @@index([enrollmentId])
}

model AttendanceAttempt {
  id                    String             @id @default(cuid())
  sessionId             String?
  enrollmentId          String?
  studentId             String?
  tokenNonceHash        String?
  ipAddress             String?
  latitude              Float?
  longitude             Float?
  accuracyMeters        Float?
  distanceMeters        Float?
  deviceFingerprintHash String?
  status                AttemptStatus
  reasonCode            String?
  createdAt             DateTime           @default(now())
  session               AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  enrollment            Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  student               User?              @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([deviceFingerprintHash, createdAt])
  @@index([sessionId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model QrScanLog {
  id             String           @id @default(cuid())
  courseId       String?
  sessionId      String?
  enrollmentId   String?
  userId         String?
  studentName    String?
  studentNumber  String?
  className      String?
  actionType     QrScanActionType @default(YOKLAMA)
  scannedBy      String?
  scanSource     String?          @default("Kamera")
  deviceInfo     String?
  ipAddress      String?
  location       String?
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  distanceMeters Float?
  result         QrScanResult     @default(SUCCESS)
  resultMessage  String?
  userAgent      String?          @db.Text
  metadata       Json?
  scannedAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())

  course     Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  session    AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  enrollment Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  user       User?              @relation("UserScanLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([scannedAt])
  @@index([courseId, scannedAt])
  @@index([userId, scannedAt])
  @@index([studentNumber])
  @@index([result])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  courseId  String?
  sessionId String?
  title     String
  message   String
  type      String    @default("ATTENDANCE_STARTED")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  session AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model BugReport {
  id                 String              @id @default(cuid())
  reporterId         String
  subject            String
  description        String              @db.Text
  screenshotPath     String
  screenshotMimeType String
  pageUrl            String?
  userAgent          String?             @db.Text
  status             BugReportStatus     @default(PENDING)
  handledById        String?
  resolvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reporter           User                @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handledBy          User?               @relation("BugReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  responses          BugReportResponse[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([handledById])
}

model BugReportResponse {
  id        String    @id @default(cuid())
  reportId  String
  authorId  String
  message   String    @db.Text
  createdAt DateTime  @default(now())
  report    BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    User      @relation("BugReportResponseAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([authorId])
}
